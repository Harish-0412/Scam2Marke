ENVIRONMENT=production
SCAM2MARKET_IMAGE=ghcr.io/harish-0412/scam2marke-backend:latest
SCAM2MARKET_ENV_FILE=.env.production
POSTGRES_PASSWORD=REPLACE_FROM_SECRET_STORE
GRAFANA_ADMIN_PASSWORD=REPLACE_FROM_SECRET_STORE
DATABASE_URL=postgresql+asyncpg://scam2market:REPLACE_FROM_SECRET_STORE@postgres:5432/scam2market
REDIS_URL=redis://redis:6379/0
REDPANDA_BOOTSTRAP_SERVERS=redpanda:9092
NEO4J_PASSWORD=REPLACE_FROM_SECRET_STORE
AUTHOR_PSEUDONYMIZATION_KEY=REPLACE_FROM_SECRET_STORE
SERVICE_API_KEY=REPLACE_FROM_SECRET_STORE
REQUIRE_API_KEY=true
RATE_LIMIT_FAIL_CLOSED=true
ALLOWED_ORIGINS=https://replace-with-dashboard-origin.example
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
