ENVIRONMENT=production
SCAM2MARKET_IMAGE=ghcr.io/harish-0412/scam2marke-backend:latest
SCAM2MARKET_ENV_FILE=.env.production
SCAM2MARKET_DOMAIN=surveillance.example.com
ACME_EMAIL=security@example.com
POSTGRES_PASSWORD=REPLACE_FROM_SECRET_STORE
GRAFANA_ADMIN_PASSWORD=REPLACE_FROM_SECRET_STORE
DATABASE_URL=postgresql+asyncpg://scam2market:REPLACE_FROM_SECRET_STORE@postgres:5432/scam2market
REDIS_URL=redis://redis:6379/0
REDPANDA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_SECURITY_PROTOCOL=SSL
NEO4J_PASSWORD=REPLACE_FROM_SECRET_STORE
AUTHOR_PSEUDONYMIZATION_KEY=REPLACE_FROM_SECRET_STORE
AUTH_REQUIRED=true
DEVELOPMENT_AUTH_ENABLED=false
DEFAULT_TENANT_ID=default
OIDC_ISSUER=https://replace-with-identity-provider.example/
OIDC_AUDIENCE=scam2market-api
OIDC_JWKS_URL=https://replace-with-identity-provider.example/.well-known/jwks.json
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
SERVICE_KEY_PEPPER=REPLACE_FROM_SECRET_STORE
SERVICE_KEY_DEFAULT_TTL_DAYS=90
RATE_LIMIT_FAIL_CLOSED=true
ALLOWED_ORIGINS=https://replace-with-dashboard-origin.example
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
MARKET_PROVIDER=binance
LIVE_MARKET_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_BASE_URL=https://api.binance.com
MARKET_POLL_INTERVAL_SECONDS=1
SOCIAL_PROVIDER=mastodon
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=REPLACE_FROM_SECRET_STORE
SOCIAL_RSS_URLS=
SOCIAL_POLL_INTERVAL_SECONDS=15
