APP_NAME=Scam2Market Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://scam2market:scam2market@postgres:5432/scam2market
REDIS_URL=redis://redis:6379/0
REDPANDA_BOOTSTRAP_SERVERS=redpanda:9092

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scam2market-password

QDRANT_URL=http://qdrant:6333
QDRANT_POST_COLLECTION=social-post-embeddings-v1
QDRANT_DISCLOSURE_COLLECTION=disclosure-chunks-v1
EMBEDDING_DIMENSIONS=128
NARRATIVE_SIMILARITY_THRESHOLD=0.76
NARRATIVE_WINDOW_SECONDS=300
CAMPAIGN_MERGE_GAP_SECONDS=1800
ALERT_SUPPRESSION_SECONDS=300
CAMPAIGN_LOCK_RETRY_COUNT=3
CAMPAIGN_LOCK_RETRY_BACKOFF_MS=50
CAMPAIGN_INACTIVITY_CLOSE_SECONDS=3600
VERIFICATION_PRE_ALERT_LOOKBACK_DAYS=30
VERIFICATION_POST_ALERT_HORIZON_DAYS=7
REALTIME_STREAM_KEY=stream:alerts:v1
REALTIME_STREAM_MAX_LENGTH=10000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ENABLED=true
MLFLOW_TIMEOUT_SECONDS=5
OTEL_EXPORTER_OTLP_ENDPOINT=
DEPENDENCY_PROBE_TIMEOUT_SECONDS=2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30
STREAM_BATCH_SIZE=50
STREAM_BATCH_WAIT_SECONDS=0.25
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=300
RATE_LIMIT_REFILL_PER_SECOND=5
RATE_LIMIT_FAIL_CLOSED=false
AUTH_REQUIRED=false
DEVELOPMENT_AUTH_ENABLED=true
DEFAULT_TENANT_ID=default
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
SERVICE_KEY_PEPPER=development-only-service-key-pepper
SERVICE_KEY_DEFAULT_TTL_DAYS=90

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

RAW_ARCHIVE_PATH=./data/raw
AUTHOR_PSEUDONYMIZATION_KEY=development-only-change-me
AUTHOR_PSEUDONYMIZATION_KEY_VERSION=1
MARKET_FRESHNESS_THRESHOLD_SECONDS=30
SOCIAL_FRESHNESS_THRESHOLD_SECONDS=300
FEATURE_ALLOWED_LATENESS_SECONDS=120
FEATURE_WINDOW_INTERVALS_SECONDS=60,300
FEATURE_SOURCE_IDLE_AFTER_SECONDS=300
